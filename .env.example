# Copy this file to .env and adjust values for your machine.

# Docker Compose published ports
API_PORT=8000
WEB_PORT=5173
REDIS_PORT=6379

# Browser-side API URL baked into the web bundle
VITE_API_BASE=http://localhost:8000/api/v1

# Optional: default pipeline config used by local scripts/Makefile
SPECTRAL_URBANISM_CONFIG=configs/city.yaml
